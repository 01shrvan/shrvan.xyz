---
import { QUOTES, quoteForDay } from "@/lib/quotes";

const quote = quoteForDay();
---

<figure data-quote class="quote">
  <blockquote>
    <p data-quote-text>&ldquo;{quote.text}&rdquo;</p>
  </blockquote>
  <figcaption>| <span data-quote-source>{quote.source}</span></figcaption>
</figure>

<script is:inline define:vars={{ pool: QUOTES }}>
  (() => {
    const root = document.querySelector("[data-quote]");
    if (!root || !Array.isArray(pool) || pool.length === 0) return;

    const now = new Date();
    const day = Math.floor(
      Date.UTC(now.getFullYear(), now.getMonth(), now.getDate()) / 86400000,
    );
    const quote = pool[day % pool.length];

    const text = root.querySelector("[data-quote-text]");
    const source = root.querySelector("[data-quote-source]");
    if (text) text.textContent = `“${quote.text}”`;
    if (source) source.textContent = quote.source;
  })();
</script>
