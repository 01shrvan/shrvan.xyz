---
import { NAV, SITE } from "@/lib/site";
import ThemeToggle from "@/components/ThemeToggle.astro";

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);

const timeFmt = new Intl.DateTimeFormat("en-GB", {
  timeZone: "Asia/Kolkata",
  hour: "2-digit",
  minute: "2-digit",
  second: "2-digit",
  hour12: false,
});
const initialTime = timeFmt.format(new Date());
---

<div class="site-backdrop flex min-h-dvh flex-col overflow-x-clip">
  <div class="site-sheet mx-auto flex w-full max-w-sheet flex-1 flex-col border-x">
    <header class="site-header sticky top-0 z-20 border-b backdrop-blur-md">
      <div class="relative flex min-h-14 items-center justify-between gap-3 px-gutter">
        <a
          href="/"
          aria-label={`${SITE.name} home`}
          class="brand-mark shrink-0 transition-colors duration-200 hover:text-filament"
        >
          <svg viewBox="0 0 32 32" width="28" height="28" aria-hidden="true" fill="none">
            <path d="M4 25 13.2 6.5h5.6L28 25h-6.2l-1.5-3.3h-8.9L9.8 25H4Z" fill="currentColor" />
            <path d="m13.3 17.2 2.7-5.8 2.7 5.8h-5.4Z" fill="var(--color-ground)" />
            <circle cx="25.5" cy="7" r="2" fill="var(--color-filament)" />
          </svg>
        </a>

        <nav class="site-nav flex min-w-0 items-center gap-1" aria-label="Primary">
          {
            NAV.map(({ href, label }) => (
              <a
                href={href}
                aria-current={isActive(href) ? "page" : undefined}
                class:list={[
                  "nav-link text-step--1 transition-colors duration-200",
                  isActive(href)
                    ? "is-active text-ink"
                    : "text-ink-soft hover:text-ink",
                ]}
              >
                {label}
              </a>
            ))
          }
          <ThemeToggle />
        </nav>

        <span class="reg-mark bottom-0 left-0"></span>
        <span class="reg-mark bottom-0 left-full"></span>
      </div>
    </header>

    <main id="main" class="flex-1">
      <slot />
    </main>

    <footer class="mt-16 border-t px-gutter py-5">
      <div class="data flex items-center justify-between gap-4 lowercase text-ink-soft">
        <span class="shrink-0 text-ink">@{SITE.aka}</span>
        <span class="truncate">{SITE.location}</span>
        <span class="shrink-0">
          <time data-clock class="text-ink">{initialTime}</time> ist
        </span>
        <span class="shrink-0">© {new Date().getFullYear()}</span>
      </div>
    </footer>
  </div>
</div>

<script is:inline>
  (() => {
    const fmt = new Intl.DateTimeFormat("en-GB", {
      timeZone: "Asia/Kolkata",
      hour: "2-digit",
      minute: "2-digit",
      second: "2-digit",
      hour12: false,
    });

    const start = () => {
      const el = document.querySelector("[data-clock]");
      if (!el) return;

      const tick = () => {
        el.textContent = fmt.format(new Date());
      };

      clearInterval(window.__clock);
      clearTimeout(window.__clockAlign);
      tick();
      window.__clockAlign = setTimeout(() => {
        tick();
        window.__clock = setInterval(tick, 1000);
      }, 1000 - (Date.now() % 1000));
    };

    document.addEventListener("astro:page-load", start);
    document.addEventListener("visibilitychange", () => {
      if (!document.hidden) start();
    });
    start();
  })();
</script>
