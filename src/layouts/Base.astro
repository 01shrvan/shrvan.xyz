---
import "@/styles/app.css";
import { ClientRouter } from "astro:transitions";
import { SITE } from "@/lib/site";

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title,
  description = SITE.description,
  image = "/og/home.jpg",
} = Astro.props;

const pageTitle = (
  title ? `${title} | ${SITE.name}` : `${SITE.name} | ${SITE.role}`
).toLowerCase();
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en" class="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32x32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-16x16.png" sizes="16x16" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE.name}
      href="/rss.xml"
    />
    <link rel="canonical" href={canonical} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.name} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={pageTitle} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content="@01shrvan" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#2b2723" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f7f1e4" media="(prefers-color-scheme: light)" />

    <script is:inline>
      (() => {
        const apply = (root) => {
          let dark = false;
          try {
            dark = localStorage.getItem("theme") === "dark";
          } catch {
          }
          root.classList.toggle("dark", dark);
          root.classList.toggle("light", !dark);
        };

        apply(document.documentElement);

        if (window.__themeBound) return;
        window.__themeBound = true;
        document.addEventListener("astro:before-swap", (event) => {
          apply(event.newDocument.documentElement);
        });
      })();
    </script>
    <ClientRouter />
    <slot name="head" />
  </head>

  <body class="grain">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-sm focus:bg-ink focus:px-4 focus:py-2 focus:text-ground"
    >
      Skip to content
    </a>

    <slot />
  </body>
</html>
