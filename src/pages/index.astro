---
import { getCollection } from "astro:content";
import Base from "@/layouts/Base.astro";
import Shell from "@/components/Shell.astro";
import RuledHeading from "@/components/RuledHeading.astro";
import EntryRow from "@/components/EntryRow.astro";
import SpecTable from "@/components/SpecTable.astro";
import StackList from "@/components/StackList.astro";
import NowPlaying from "@/components/NowPlaying.astro";
import Quote from "@/components/Quote.astro";
import { SITE, EXPERIENCE } from "@/lib/site";

const works = (await getCollection("works")).sort(
  (a, b) => a.data.order - b.data.order,
);

const writings = (await getCollection("writings"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const monthYear = new Intl.DateTimeFormat("en-US", {
  month: "short",
  year: "numeric",
});
const stamp = (d: Date) => monthYear.format(d).toLowerCase();
const hasDetail = (w: { body?: string; data: { verify: unknown[]; numbers: unknown[]; counter?: unknown } }) =>
  Boolean(w.body?.trim()) ||
  w.data.verify.length > 0 ||
  w.data.numbers.length > 0 ||
  Boolean(w.data.counter);
---

<Base image="/og/home.jpg">
  <Shell>
    <section class="home-hero px-gutter">
      <div class="hero-art" aria-hidden="true">
        <svg viewBox="0 0 760 174" preserveAspectRatio="xMidYMid slice" role="presentation">
          <defs>
            <pattern id="hero-dots" width="7" height="7" patternUnits="userSpaceOnUse">
              <circle cx="1.5" cy="1.5" r="1.25" fill="currentColor" />
            </pattern>
            <mask id="hero-wave-mask">
              <rect width="760" height="174" fill="black" />
              <path d="M-20 32 C82 28 106 135 212 105 S341 15 431 61 548 150 642 95 728 30 790 45 V0 H-20Z" fill="white" />
            </mask>
          </defs>
          <rect width="760" height="174" fill="url(#hero-dots)" mask="url(#hero-wave-mask)" />
          <path d="M495 104c44-9 70 13 111 2m-45 12c26 4 38 16 64 12" fill="none" stroke="var(--color-filament)" stroke-width="2" stroke-linecap="round" stroke-dasharray="1 7" />
          <circle cx="151" cy="111" r="3" fill="var(--color-filament)" />
          <circle cx="581" cy="60" r="2.5" fill="var(--color-filament)" />
        </svg>
      </div>
      <div class="hero-copy">
        <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-step--1 text-ink-soft">
          <span class="font-serif text-step-1 text-ink">Shrvan Benke</span>
          <span class="data rounded-full border px-2 py-0.5">aka {SITE.aka}</span>
          <span class="location-mark" aria-hidden="true">✳</span>
          <span>{SITE.location}</span>
        </div>
        <h1 class="display mt-3 text-step-2">I build thoughtful software.</h1>
        <p class="mt-2 max-w-measure text-step--1 leading-relaxed text-ink-soft">
          Full-stack engineer, frontend at heart. I turn rough ideas into useful products and care about every detail between the first sketch and the final click.
        </p>
        <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2 text-step--1">
          <a class="link" href={`mailto:${SITE.email}`}>Say hello <span aria-hidden="true">↗</span></a>
          <span class="availability"><span class="anim-mark" aria-hidden="true"></span> Open to good projects</span>
        </div>
      </div>
    </section>

    <section class="home-section px-gutter">
      <RuledHeading count={works.length}>Selected work</RuledHeading>
      <p class="section-note">A few things I&apos;ve been making lately.</p>
      <div class="mt-2">
        {
          works.map((entry, i) => (
            <EntryRow
              title={entry.data.title}
              href={hasDetail(entry) ? `/works/${entry.id}` : entry.data.href}
              stamp={String(entry.data.date.getFullYear())}
              meta={entry.data.role}
              description={entry.data.description}
              stack={entry.data.stack}
              external={!hasDetail(entry)}
              index={i}
            />
          ))
        }
      </div>
    </section>

    <section class="home-section px-gutter">
      <RuledHeading count={EXPERIENCE.length}>Experience</RuledHeading>
      <div class="mt-2">
        {
          EXPERIENCE.map((job, i) => (
            <div style={`animation-delay:${90 + i * 45}ms`} class="anim-lift py-3">
              <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
                <span class="data shrink-0 text-ink-soft sm:w-rail">{job.stamp}</span>
                <span class="font-medium">{job.role}</span>
                <span class="leader hidden sm:block" />
                <span class="data shrink-0 text-ink-soft">{job.period} · {job.company} · {job.place}</span>
              </div>
              <p class="mt-1 text-step--1 leading-relaxed text-ink-soft sm:ml-rail-offset">{job.note}</p>
            </div>
          ))
        }
      </div>
    </section>

    <section class="home-section px-gutter">
      <RuledHeading href="/writings" linkLabel="all">Notes from the process</RuledHeading>
      <div class="mt-2">
        {
          writings.slice(0, 3).map((post, i) => (
            <EntryRow
              title={post.data.title}
              href={`/writings/${post.id}`}
              stamp={stamp(post.data.date)}
              description={post.data.tldr}
              index={i}
            />
          ))
        }
      </div>
    </section>

    <section class="home-section px-gutter">
      <RuledHeading>Currently</RuledHeading>
      <div class="mt-4">
        <SpecTable
          rows={[
            { label: "status", value: "open to freelance, contract and full-time", live: true },
            { label: "based", value: "mumbai, india (utc+5:30)", clock: true },
            { label: "focus", value: SITE.focus },
          ]}
        >
          <NowPlaying />
        </SpecTable>
      </div>
    </section>

    <section class="home-section px-gutter">
      <RuledHeading>Tools I reach for</RuledHeading>
      <div class="mt-4"><StackList /></div>
    </section>

    <section class="home-section px-gutter"><Quote /></section>
  </Shell>
</Base>
